/* pages/cases/cases.wxss */
.cases-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
  background-color: white;
  display: flex;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 0 24rpx;
  height: 68rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 68rpx;
  line-height: 68rpx;
}

.clear-icon {
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}

.search-btn {
  width: 140rpx;
  height: 68rpx;
  line-height: 68rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 34rpx;
  font-size: 28rpx;
  padding: 0;
  border: none;
}

/* 热门推荐 */
.hot-section {
  padding: 24rpx 30rpx 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
}

.section-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* 年级选择 */
.grade-section {
  padding: 0 30rpx 20rpx;
}

.grade-header {
  margin-bottom: 16rpx;
}

.grade-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.grade-tabs {
  white-space: nowrap;
  display: flex;
}

.grade-tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  background-color: white;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.grade-tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-weight: bold;
}

/* 项目列表 */
.projects-list {
  padding: 0 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.project-card {
  width: calc(50% - 10rpx);
  background-color: white;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  min-height: 240rpx;
  transition: all 0.3s;
}

.project-card:active {
  transform: scale(0.98);
}

.project-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
  gap: 12rpx;
}

.project-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.project-price {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: bold;
  white-space: nowrap;
}

.subject-tag {
  background-color: #e3f2fd;
  color: #2196f3;
}

.grade-tag {
  background-color: #f3e5f5;
  color: #9c27b0;
}

.project-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.project-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stat-icon {
  font-size: 24rpx;
}

.stat-text {
  font-size: 22rpx;
  color: #999;
}

.project-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
}
