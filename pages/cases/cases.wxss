/* pages/cases/cases.wxss */
.cases-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
  background-color: white;
  display: flex;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 0 24rpx;
  height: 68rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 68rpx;
  line-height: 68rpx;
}

.clear-icon {
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}

.search-btn {
  width: 140rpx;
  height: 68rpx;
  line-height: 68rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 34rpx;
  font-size: 28rpx;
  padding: 0;
  border: none;
}

/* 热门推荐 */
.hot-section {
  padding: 24rpx 30rpx 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
}

.section-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* 主内容区 */
.main-content {
  display: flex;
  height: calc(100vh - 300rpx);
}

/* 左侧年级栏 */
.grade-sidebar {
  width: 160rpx;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.grade-item {
  padding: 32rpx 20rpx;
  text-align: center;
  background-color: #f5f5f5;
  border-right: 4rpx solid transparent;
  transition: all 0.3s;
}

.grade-item.active {
  background-color: white;
  border-right-color: #4A90E2;
}

.grade-text {
  font-size: 28rpx;
  color: #666;
}

.grade-item.active .grade-text {
  color: #4A90E2;
  font-weight: bold;
}

/* 右侧滚动区域 */
.projects-scroll {
  flex: 1;
  height: 100%;
  background-color: white;
}

/* 项目列表 */
.projects-list {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.project-card {
  background-color: #f9f9f9;
  padding: 24rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  transition: all 0.3s;
}

.project-card:active {
  transform: scale(0.98);
  background-color: #f0f0f0;
}

.project-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.project-price {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  font-size: 22rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: bold;
  white-space: nowrap;
}

.subject-tag {
  background-color: #e3f2fd;
  color: #2196f3;
}

.project-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.project-stats {
  display: flex;
  gap: 16rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stat-icon {
  font-size: 22rpx;
}

.stat-text {
  font-size: 20rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
}
