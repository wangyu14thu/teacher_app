/* pages/my-school/my-school.wxss */
.school-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #667eea 0%, #f5f7fa 500rpx);
  padding-bottom: 40rpx;
}

/* 学校头部 */
.school-header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.school-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.school-name {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.school-welcome {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 数据面板 */
.stats-panel {
  margin: 0 30rpx 30rpx;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 56rpx;
  font-weight: bold;
  color: #667eea;
  line-height: 1;
  margin-bottom: 12rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 2rpx;
  height: 100rpx;
  background: #f0f0f0;
}

.quota-item {
  position: relative;
}

.quota-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 12rpx;
}

.quota-total {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.quota-remaining {
  font-size: 40rpx;
  font-weight: bold;
  color: #52c41a;
}

/* 排序栏 */
.sort-bar {
  margin: 0 30rpx 20rpx;
  padding: 24rpx 30rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.sort-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.sort-options {
  display: flex;
  gap: 20rpx;
}

.sort-option {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.sort-option.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-weight: bold;
}

/* 项目区块 */
.projects-section {
  padding: 0 30rpx;
}

.project-card {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
  border-left: 6rpx solid #667eea;
}

.project-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.project-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.project-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-right: 16rpx;
}

.project-badges {
  display: flex;
  gap: 8rpx;
}

.badge-hot {
  font-size: 28rpx;
}

.badge-new {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff4757 100%);
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.project-meta {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #999;
}

.meta-divider {
  margin: 0 12rpx;
  color: #d9d9d9;
}

.project-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.project-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 28rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.project-time {
  font-size: 24rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  background: white;
  border-radius: 20rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.btn-goto-cases {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-goto-cases::after {
  border: none;
}

