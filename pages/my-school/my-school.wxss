/* pages/my-school/my-school.wxss */
.school-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #667eea 0%, #f5f7fa 500rpx);
  padding-bottom: 40rpx;
  display: flex;
  flex-direction: column;
}

/* 学校头部 */
.school-header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.school-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.school-name {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.school-welcome {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 数据面板 */
.stats-panel {
  margin: 0 30rpx 30rpx;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 56rpx;
  font-weight: bold;
  color: #667eea;
  line-height: 1;
  margin-bottom: 12rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 2rpx;
  height: 100rpx;
  background: #f0f0f0;
}

.quota-item {
  position: relative;
}

.quota-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 12rpx;
}

.quota-total {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.quota-remaining {
  font-size: 40rpx;
  font-weight: bold;
  color: #52c41a;
}

/* 空状态 */
.empty-state-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  margin: 0 30rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.btn-goto-cases {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-goto-cases::after {
  border: none;
}

