<!--pages/my-school/my-school.wxml-->
<scroll-view scroll-y class="school-container">
  <!-- 有学校时显示 -->
  <view wx:if="{{hasSchool}}">
    <!-- 学校信息头部 -->
    <view class="school-header">
      <view class="school-icon">🏫</view>
      <text class="school-name">{{schoolInfo.name}}</text>
      <text class="school-welcome">欢迎来到{{schoolInfo.name}}校本资源库</text>
    </view>

    <!-- 核心数据面板 -->
    <view class="stats-panel">
      <view class="stat-item">
        <text class="stat-number">{{schoolInfo.memberCount}}</text>
        <text class="stat-label">当前成员</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item quota-item">
        <view class="quota-info">
          <text class="quota-total">共{{schoolInfo.totalQuota}}次</text>
          <text class="quota-remaining">剩余{{schoolInfo.remainingQuota}}次</text>
        </view>
        <text class="stat-label">本校共享额度</text>
      </view>
    </view>

    <!-- 邀请码区域（仅管理员可见） -->
    <view wx:if="{{schoolInfo.inviteCode && schoolInfo.isAdmin}}" class="invite-code-section">
      <view class="invite-code-header">
        <text class="section-title">学校邀请码</text>
        <text class="admin-badge">管理员</text>
      </view>
      <view class="invite-code-card">
        <text class="invite-code">{{schoolInfo.inviteCode}}</text>
        <button class="btn-copy" bindtap="copyInviteCode">复制</button>
      </view>
      <text class="invite-tip">将邀请码分享给本校同事，邀请他们加入</text>
    </view>

    <!-- 学校成员列表 -->
    <view class="members-section">
      <view class="section-header">
        <text class="section-title">学校成员 ({{members.length}})</text>
      </view>
      
      <view wx:if="{{members.length > 0}}" class="members-list">
        <view 
          wx:for="{{members}}" 
          wx:key="id" 
          class="member-item"
        >
          <view class="member-avatar">{{item.nickname ? item.nickname.substring(0, 1) : '教'}}</view>
          <view class="member-info">
            <text class="member-name">{{item.nickname || '教师'}}</text>
            <text class="member-meta">{{item.subject || ''}} · {{item.grade || ''}}</text>
          </view>
          <view wx:if="{{item.isAdmin}}" class="role-badge">管理员</view>
          <text wx:else class="join-time">{{item.joinTime}}</text>
        </view>
      </view>

      <view wx:else class="empty-members">
        <text class="empty-text">暂无其他成员</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state-main">
      <text class="empty-icon">📦</text>
      <text class="empty-text">本校暂无项目</text>
      <button class="btn-goto-cases" bindtap="goToCases">去项目库看看</button>
    </view>
  </view>

  <!-- 没有学校时显示 -->
  <view wx:else class="no-school-container">
    <view class="no-school-icon">🏫</view>
    <text class="no-school-title">您还没有加入学校</text>
    <text class="no-school-desc">创建或加入学校团队，享受校本资源共享</text>
    
    <view class="action-buttons">
      <button class="btn-join" bindtap="showJoinSchool">输入邀请码加入</button>
      <button class="btn-goto-cases" bindtap="goToCases">去项目库看看</button>
    </view>
  </view>
</scroll-view>

<!-- 加入学校弹窗 -->
<view wx:if="{{showJoinModal}}" class="modal-mask" bindtap="closeJoinModal">
  <view class="modal-content" catchtap="preventClose">
    <view class="modal-header">
      <text class="modal-title">加入学校</text>
      <text class="modal-close" bindtap="closeJoinModal">✕</text>
    </view>
    
    <view class="modal-body">
      <text class="input-label">请输入学校邀请码</text>
      <input 
        class="invite-input" 
        type="text" 
        placeholder="8位邀请码" 
        maxlength="8"
        value="{{inviteCodeInput}}"
        bindinput="onInviteCodeInput"
      />
      <text class="input-tip">向学校管理员获取邀请码</text>
    </view>
    
    <view class="modal-footer">
      <button class="btn-cancel" bindtap="closeJoinModal">取消</button>
      <button class="btn-confirm" bindtap="confirmJoinSchool">确认加入</button>
    </view>
  </view>
</view>

