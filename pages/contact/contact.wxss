/* pages/contact/contact.wxss */
.contact-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #4A90E2 0%, #f5f7fa 400rpx);
  padding: 40rpx 30rpx;
}

/* 页面头部 */
.page-header {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.header-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 24rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 联系方式卡片 */
.contact-card {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 30rpx;
}

.card-section {
  margin-bottom: 0;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-item:active {
  background: #e8eaed;
}

.info-label {
  width: 80rpx;
  font-size: 28rpx;
  color: #666;
}

.info-value {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.info-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 工作时间 */
.time-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx 20rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}

.time-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 在线客服按钮 */
.btn-service {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  border: none;
}

.btn-service::after {
  border: none;
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.btn-text {
  flex: 1;
  font-size: 30rpx;
  color: white;
  font-weight: 500;
  text-align: left;
}

.btn-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 32rpx 0;
}

/* 常见问题 */
.faq-section {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 30rpx;
}

.faq-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.faq-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.faq-item:active {
  background: #e8eaed;
  transform: translateX(4rpx);
}

.faq-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.faq-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.faq-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 反馈建议 */
.feedback-section {
  padding: 20rpx 0;
}

.btn-feedback {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  border: 2rpx dashed #4A90E2;
  font-size: 30rpx;
  color: #4A90E2;
  font-weight: 500;
}

.btn-feedback::after {
  border: none;
}

.btn-feedback:active {
  background: #f0f5ff;
}

.btn-feedback .btn-icon {
  font-size: 36rpx;
}

