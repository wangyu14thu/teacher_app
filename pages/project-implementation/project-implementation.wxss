/* pages/project-implementation/project-implementation.wxss */
.implementation-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #f5f7fa 0%, #ffffff 300rpx);
  padding: 30rpx 30rpx 200rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin: 40rpx 0 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 项目信息卡片 */
.project-info-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
}

.project-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.project-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

/* 表单区块 */
.form-section {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 32rpx;
}

.title-dot {
  color: #667eea;
  margin-right: 12rpx;
  font-size: 24rpx;
}

/* 上传项 */
.upload-item {
  margin-bottom: 40rpx;
}

.upload-item:last-child {
  margin-bottom: 0;
}

.upload-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.label-count {
  font-size: 24rpx;
  color: #999;
}

/* 图片网格 */
.upload-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background: #f5f5f5;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
  z-index: 10;
}

.upload-btn {
  width: 100%;
  padding-bottom: 100%;
  position: relative;
  background: #f5f7fa;
  border: 2rpx dashed #d9d9d9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -80%);
  font-size: 56rpx;
  color: #999;
}

.upload-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, 40%);
  font-size: 22rpx;
  color: #999;
}

.upload-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.6;
}

/* 探究项 */
.inquiry-item {
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid #e0e0e0;
}

.inquiry-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.inquiry-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
}

.btn-delete {
  background: #ff4d4f;
  color: white;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border: none;
}

.btn-delete::after {
  border: none;
}

.inquiry-question {
  margin-bottom: 32rpx;
}

.question-input {
  width: 100%;
  background: white;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.btn-add-inquiry {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  color: #667eea;
  border: 2rpx dashed #667eea;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-add-inquiry::after {
  border: none;
}

.btn-add-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  gap: 20rpx;
  z-index: 100;
}

.btn-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  padding: 24rpx 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  min-height: 120rpx;
}

.btn-action::after {
  border: none;
}

.btn-action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.btn-save {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: white;
}

.btn-preview {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: white;
}

