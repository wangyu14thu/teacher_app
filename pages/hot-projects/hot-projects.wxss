/* pages/hot-projects/hot-projects.wxss */
.hot-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

.page-header {
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  background-color: white;
  padding: 20rpx 30rpx;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.sort-item {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 30rpx;
  background-color: #f5f5f5;
  transition: all 0.3s;
}

.sort-item.active {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
}

.sort-text {
  font-size: 26rpx;
  color: #666;
}

.sort-item.active .sort-text {
  color: white;
  font-weight: bold;
}

/* 项目列表 */
.projects-list {
  padding: 20rpx 30rpx;
}

.project-card {
  background-color: white;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  transition: all 0.3s;
}

.project-card:active {
  transform: scale(0.98);
}

.rank-badge {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  flex-shrink: 0;
}

.project-content {
  flex: 1;
  min-width: 0;
}

.project-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: bold;
  white-space: nowrap;
}

.subject-tag {
  background-color: #e3f2fd;
  color: #2196f3;
}

.grade-tag {
  background-color: #f3e5f5;
  color: #9c27b0;
}

.project-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stat-item.hot-score {
  margin-left: auto;
}

.stat-icon {
  font-size: 24rpx;
}

.stat-text {
  font-size: 22rpx;
  color: #999;
}

.hot-score .stat-text {
  color: #ff6b6b;
  font-weight: bold;
}

.project-price {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

