<!--pages/hot-projects/hot-projects.wxml-->
<view class="hot-container">
  <view class="page-header">
    <text class="header-title">热门推荐</text>
    <text class="header-subtitle">最受欢迎的项目案例</text>
  </view>

  <!-- 排序方式 -->
  <view class="sort-bar">
    <view 
      class="sort-item {{sortType === 'likes' ? 'active' : ''}}" 
      bindtap="changeSortType"
      data-type="likes"
    >
      <text class="sort-text">点赞最多</text>
    </view>
    <view 
      class="sort-item {{sortType === 'favorites' ? 'active' : ''}}" 
      bindtap="changeSortType"
      data-type="favorites"
    >
      <text class="sort-text">收藏最多</text>
    </view>
    <view 
      class="sort-item {{sortType === 'hot' ? 'active' : ''}}" 
      bindtap="changeSortType"
      data-type="hot"
    >
      <text class="sort-text">综合热度</text>
    </view>
  </view>

  <!-- 热门项目列表 -->
  <view class="projects-list">
    <view 
      class="project-card" 
      wx:for="{{hotProjects}}" 
      wx:key="id"
      bindtap="viewProject"
      data-id="{{item.id}}"
    >
      <view class="rank-badge">{{index + 1}}</view>
      
      <view class="project-content">
        <text class="project-title">{{item.title}}</text>
        
        <view class="project-tags">
          <view class="tag subject-tag">{{item.subject}}</view>
          <view class="tag grade-tag">{{item.gradeName}}</view>
        </view>

        <view class="project-stats">
          <view class="stat-item">
            <text class="stat-icon">👍</text>
            <text class="stat-text">{{item.likes}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">⭐</text>
            <text class="stat-text">{{item.favorites}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">💬</text>
            <text class="stat-text">{{item.comments}}</text>
          </view>
          <view class="stat-item hot-score">
            <text class="stat-icon">🔥</text>
            <text class="stat-text">{{item.hotScore}}</text>
          </view>
        </view>
      </view>

      <view class="project-price">¥{{item.price}}</view>
    </view>
  </view>
</view>

