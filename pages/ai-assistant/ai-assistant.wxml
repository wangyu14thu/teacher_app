<!--pages/ai-assistant/ai-assistant.wxml-->
<view class="assistant-container">
  <!-- 顶部标签栏 -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab === 'messages' ? 'active' : ''}}" bindtap="switchTab" data-tab="messages">
      <text class="tab-text">系统消息</text>
      <view class="unread-badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</view>
    </view>
    <view class="tab-item {{currentTab === 'ai' ? 'active' : ''}}" bindtap="switchTab" data-tab="ai">
      <text class="tab-text">AI助手</text>
    </view>
  </view>

  <!-- 系统消息列表 -->
  <scroll-view class="content-area" scroll-y wx:if="{{currentTab === 'messages'}}">
    <view class="messages-list">
      <view class="message-card {{item.read ? 'read' : 'unread'}}" 
            wx:for="{{messages}}" 
            wx:key="id" 
            bindtap="viewMessage" 
            data-id="{{item.id}}">
        <!-- 未读标识 -->
        <view class="unread-dot" wx:if="{{!item.read}}"></view>
        
        <view class="message-content">
          <view class="message-header">
            <text class="message-title">{{item.title}}</text>
            <text class="message-time">{{item.time}}</text>
          </view>
          
          <view class="message-preview">
            <text class="preview-text">{{item.preview}}</text>
          </view>
          
          <!-- 特殊内容：邀请码 -->
          <view class="invite-code-box" wx:if="{{item.type === 'invite_code'}}">
            <text class="code-label">邀请码：</text>
            <text class="code-value">{{item.inviteCode}}</text>
            <button class="btn-copy" bindtap="copyCode" data-code="{{item.inviteCode}}">复制</button>
          </view>
          
          <!-- 操作按钮 -->
          <view class="message-actions" wx:if="{{item.actionText}}">
            <button class="btn-action" bindtap="handleMessageAction" data-id="{{item.id}}">
              {{item.actionText}}
            </button>
          </view>
        </view>
      </view>
      
      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{messages.length === 0}}">
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无消息</text>
      </view>
    </view>
  </scroll-view>

  <!-- AI助手 -->
  <view class="ai-chat-container" wx:if="{{currentTab === 'ai'}}">
    <!-- 使用提示栏 -->
    <view class="usage-bar">
      <text class="usage-text">今日剩余：{{remainingQuota}}/{{dailyLimit}}次</text>
      <text class="usage-tip" wx:if="{{remainingQuota <= 5 && remainingQuota > 0}}">💡 提问次数不多了</text>
      <text class="usage-warning" wx:if="{{remainingQuota === 0}}">⚠️ 今日次数已用完</text>
    </view>
    
    <!-- 聊天记录 -->
    <scroll-view class="chat-history" scroll-y scroll-into-view="{{scrollToId}}" scroll-with-animation>
      <view class="chat-messages">
        <!-- 用户消息 - 左侧 -->
        <view wx:for="{{chatHistory}}" wx:key="id" id="msg-{{item.id}}">
          <view wx:if="{{item.sender === 'user'}}" class="message-row user-row">
            <image class="message-avatar" src="/images/me.png" mode="aspectFill"></image>
            <view class="message-bubble user-bubble">
              <text class="message-text">{{item.content}}</text>
              <text class="message-timestamp">{{item.time}}</text>
            </view>
          </view>
          
          <!-- AI消息 - 右侧 -->
          <view wx:if="{{item.sender === 'ai'}}" class="message-row ai-row">
            <view class="message-bubble ai-bubble">
              <text class="message-text">{{item.content}}</text>
              
              <!-- 工具调用展示 -->
              <view wx:if="{{item.toolCalls && item.toolCalls.length > 0}}" class="tool-calls">
                <view wx:for="{{item.toolCalls}}" wx:for-item="tool" wx:key="index" class="tool-call-item">
                  <text class="tool-icon">🔧</text>
                  <text class="tool-name">{{tool.tool}}</text>
                  <text class="tool-status">{{tool.status}}</text>
                </view>
              </view>
              
              <!-- 建议按钮 -->
              <view wx:if="{{item.suggestions && item.suggestions.length > 0}}" class="suggestions">
                <button 
                  wx:for="{{item.suggestions}}" 
                  wx:for-item="suggestion"
                  wx:key="index" 
                  class="suggestion-btn"
                  data-suggestion="{{suggestion}}"
                  bindtap="handleSuggestion"
                >
                  {{suggestion.text}}
                </button>
              </view>
              
              <text class="message-timestamp">{{item.time}}</text>
            </view>
            <image class="message-avatar" src="/images/ai-assistant.png" mode="aspectFill"></image>
          </view>
        </view>
        
        <!-- AI正在输入 -->
        <view wx:if="{{isAiTyping}}" class="message-row ai-row">
          <view class="message-bubble ai-bubble typing-bubble">
            <view class="typing-indicator">
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
            </view>
          </view>
          <image class="message-avatar" src="/images/ai-assistant.png" mode="aspectFill"></image>
        </view>
        
        <!-- 空状态 -->
        <view class="empty-chat" wx:if="{{chatHistory.length === 0 && !isAiTyping}}">
          <text class="empty-icon">🤖</text>
          <text class="empty-title">AI助手</text>
          <text class="empty-desc">您好！我是您的AI助手，可以帮助您：</text>
          <view class="feature-list">
            <text class="feature-item">• 项目设计咨询</text>
            <text class="feature-item">• 跨学科概念生成</text>
            <text class="feature-item">• 驱动性问题优化</text>
            <text class="feature-item">• 教学策略建议</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 输入框 -->
    <view class="chat-input-bar">
      <textarea 
        class="chat-input" 
        placeholder="输入您的问题..." 
        value="{{inputText}}"
        bindinput="onInputChange"
        auto-height
        maxlength="500"
        show-confirm-bar="{{false}}"
      />
      <button class="btn-send {{inputText ? 'active' : ''}}" bindtap="sendMessage">
        发送
      </button>
    </view>
  </view>
</view>
