/* pages/ai-assistant/ai-assistant.wxss */
.assistant-container {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: white;
  border-bottom: 2rpx solid #e0e0e0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  position: relative;
}

.tab-item.active {
  color: #4A90E2;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #4A90E2;
  border-radius: 3rpx;
}

.tab-text {
  font-size: 32rpx;
  font-weight: 500;
}

.unread-badge {
  position: absolute;
  top: 18rpx;
  right: 35%;
  background: #ff4d4f;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

/* 内容区域 */
.content-area {
  flex: 1;
  height: calc(100vh - 100rpx);
}

/* 系统消息列表 */
.messages-list {
  padding: 20rpx 30rpx;
}

.message-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.message-card.unread {
  border-left: 6rpx solid #4A90E2;
}

.unread-dot {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 16rpx;
  height: 16rpx;
  background: #4A90E2;
  border-radius: 50%;
}

.message-content {
  display: flex;
  flex-direction: column;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.message-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  padding-right: 40rpx;
}

/* 工具调用展示 */
.tool-calls {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 8rpx;
}

.tool-call-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.tool-icon {
  font-size: 24rpx;
}

.tool-name {
  font-size: 24rpx;
  color: #667eea;
  flex: 1;
}

.tool-status {
  font-size: 22rpx;
  color: #52c41a;
}

/* 建议按钮 */
.suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.suggestion-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 24rpx;
  font-size: 26rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.suggestion-btn::after {
  border: none;
}

/* 清除按钮 */
.btn-clear-chat {
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: white;
  color: #999;
  border: 2rpx solid #e0e0e0;
  border-radius: 32rpx;
  font-size: 28rpx;
  margin-right: 12rpx;
}

.btn-clear-chat::after {
  border: none;
}

.message-time {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.message-preview {
  margin-bottom: 16rpx;
}

.preview-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 邀请码卡片 */
.invite-code-box {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 24rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.code-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 16rpx;
}

.code-value {
  flex: 1;
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  letter-spacing: 4rpx;
  font-family: 'Courier New', monospace;
}

.btn-copy {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  border: none;
  backdrop-filter: blur(10rpx);
}

.btn-copy::after {
  border: none;
}

/* 消息操作按钮 */
.message-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.btn-action {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border-radius: 30rpx;
  border: none;
}

.btn-action::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* AI聊天容器 */
.ai-chat-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: calc(100vh - 100rpx);
}

/* 聊天记录 */
.chat-history {
  flex: 1;
  background: #f5f7fa;
  padding: 20rpx 30rpx 120rpx;
}

.chat-messages {
  display: flex;
  flex-direction: column;
}

.chat-message {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.user-message {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-message .message-avatar {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  margin-left: 20rpx;
}

.ai-message .message-avatar {
  margin-right: 20rpx;
}

.avatar-emoji {
  font-size: 48rpx;
}

.message-bubble {
  max-width: 500rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.user-message .message-bubble {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.message-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.user-message .message-text {
  color: white;
}

.message-timestamp {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.user-message .message-timestamp {
  color: rgba(255, 255, 255, 0.7);
  text-align: right;
}

/* 空聊天状态 */
.empty-chat {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-chat .empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}

/* 输入框 */
.chat-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #e0e0e0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 100;
}

.chat-input {
  flex: 1;
  background: #f5f7fa;
  border: none;
  border-radius: 30rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #333;
}

.btn-send {
  background: #e0e0e0;
  color: #999;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 30rpx;
  border: none;
  transition: all 0.3s;
}

.btn-send.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-send::after {
  border: none;
}
