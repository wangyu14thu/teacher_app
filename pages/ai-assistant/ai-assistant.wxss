/* pages/ai-assistant/ai-assistant.wxss */
.assistant-container {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: white;
  border-bottom: 2rpx solid #e0e0e0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  position: relative;
}

.tab-item.active {
  color: #4A90E2;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #4A90E2;
  border-radius: 3rpx;
}

.tab-text {
  font-size: 32rpx;
  font-weight: 500;
}

.unread-badge {
  position: absolute;
  top: 18rpx;
  right: 35%;
  background: #ff4d4f;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

/* 内容区域 */
.content-area {
  flex: 1;
  height: calc(100vh - 100rpx);
}

/* 系统消息列表 */
.messages-list {
  padding: 20rpx 30rpx;
}

.message-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.message-card.unread {
  border-left: 6rpx solid #4A90E2;
}

.unread-dot {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 16rpx;
  height: 16rpx;
  background: #4A90E2;
  border-radius: 50%;
}

.message-content {
  display: flex;
  flex-direction: column;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.message-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  padding-right: 40rpx;
}

.message-time {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.message-preview {
  margin-bottom: 16rpx;
}

.preview-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 邀请码卡片 */
.invite-code-box {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 24rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.code-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 16rpx;
}

.code-value {
  flex: 1;
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  letter-spacing: 4rpx;
  font-family: 'Courier New', monospace;
}

.btn-copy {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  border: none;
  backdrop-filter: blur(10rpx);
}

.btn-copy::after {
  border: none;
}

/* 消息操作按钮 */
.message-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.btn-action {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border-radius: 30rpx;
  border: none;
}

.btn-action::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* ===== AI助手聊天区域 ===== */
.ai-chat-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: calc(100vh - 100rpx);
  overflow: hidden;
}

.chat-history {
  flex: 1;
  background: #f5f7fa;
  padding: 20rpx 30rpx;
  padding-bottom: 180rpx;
  overflow-y: auto;
}

.chat-messages {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 消息行 */
.message-row {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  animation: fadeIn 0.3s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 用户消息（左侧） */
.user-row {
  flex-direction: row;
  justify-content: flex-start;
}

/* AI消息（右侧） */
.ai-row {
  flex-direction: row-reverse;
  justify-content: flex-start;
}

/* 头像 */
.message-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

/* 消息气泡 */
.message-bubble {
  max-width: 540rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

/* 用户气泡（蓝色渐变） */
.user-bubble {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-bottom-left-radius: 8rpx;
}

/* AI气泡（白色） */
.ai-bubble {
  background: white;
  color: #333;
  border-bottom-right-radius: 8rpx;
}

/* 消息文字 */
.message-text {
  display: block;
  font-size: 32rpx;
  line-height: 1.75;
  word-wrap: break-word;
  white-space: pre-wrap;
}

/* 时间戳 */
.message-timestamp {
  display: block;
  font-size: 22rpx;
  margin-top: 12rpx;
  opacity: 0.65;
}

.user-bubble .message-timestamp {
  color: rgba(255, 255, 255, 0.9);
}

.ai-bubble .message-timestamp {
  color: #999;
}

/* 工具调用展示 */
.tool-calls {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 8rpx;
}

.tool-call-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.tool-icon {
  font-size: 24rpx;
}

.tool-name {
  font-size: 24rpx;
  color: #667eea;
  flex: 1;
}

.tool-status {
  font-size: 22rpx;
  color: #52c41a;
}

/* 建议按钮 */
.suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.suggestion-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 24rpx;
  font-size: 26rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.suggestion-btn::after {
  border: none;
}

/* AI正在输入动画 */
.typing-bubble {
  padding: 24rpx 32rpx;
}

.typing-indicator {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.typing-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #667eea;
  animation: typing 1.4s infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-12rpx);
    opacity: 1;
  }
}

/* 空聊天状态 */
.empty-chat {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-chat .empty-icon {
  font-size: 140rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  text-align: center;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: flex-start;
}

.feature-item {
  font-size: 26rpx;
  color: #999;
  line-height: 1.8;
}

/* 输入框区域 */
.chat-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  border-top: 1rpx solid #e8e8e8;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.chat-input {
  flex: 1;
  min-height: 88rpx;
  max-height: 240rpx;
  padding: 22rpx 28rpx;
  background: #f5f7fa;
  border-radius: 24rpx;
  font-size: 32rpx;
  line-height: 1.6;
  box-sizing: border-box;
  color: #333;
}

.btn-send {
  width: 100rpx;
  height: 88rpx;
  padding: 0;
  background: #e0e0e0;
  color: #999;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: none;
  transition: all 0.3s ease;
}

.btn-send::after {
  border: none;
}

.btn-send.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
  transform: scale(1.02);
}
