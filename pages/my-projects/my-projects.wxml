<!--pages/my-projects/my-projects.wxml-->
<view class="myprojects-container">
  <view class="page-header">
    <text class="header-title">我的项目</text>
    <text class="header-desc">选择您要进行的操作</text>
  </view>

  <view class="entry-grid">
    <!-- 设计项目 -->
    <view class="entry-card design-card" bindtap="goToDesign">
      <view class="card-icon-bg design-bg">
        <text class="card-icon">✨</text>
      </view>
      <text class="card-title">设计项目</text>
      <text class="card-desc">AI辅助生成专属项目</text>
      <view class="card-arrow">→</view>
    </view>

    <!-- 实施项目 -->
    <view class="entry-card implement-card" bindtap="goToImplement">
      <view class="card-icon-bg implement-bg">
        <text class="card-icon">📸</text>
      </view>
      <text class="card-title">实施项目</text>
      <text class="card-desc">记录项目实施过程</text>
      <view class="card-arrow">→</view>
    </view>
  </view>

  <!-- 提示信息 -->
  <view class="tip-card">
    <text class="tip-icon">💡</text>
    <view class="tip-content">
      <text class="tip-title">温馨提示</text>
      <text class="tip-text">设计完成的项目可以在"我的-我的项目"中查看和管理</text>
    </view>
  </view>
</view>

