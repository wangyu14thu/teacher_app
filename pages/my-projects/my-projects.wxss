/* pages/my-projects/my-projects.wxss */
.myprojects-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #f5f7fa 0%, #ffffff 400rpx);
  padding: 40rpx 30rpx;
}

.page-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.header-title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.header-desc {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.entry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
  margin-bottom: 40rpx;
}

.entry-card {
  position: relative;
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 30rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
  overflow: hidden;
}

.entry-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.entry-card:active {
  transform: translateY(-8rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
}

.design-card::before {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.implement-card::before {
  background: linear-gradient(90deg, #f093fb 0%, #f5576c 100%);
}

.card-icon-bg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.design-bg {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.4);
}

.implement-bg {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  box-shadow: 0 8rpx 20rpx rgba(240, 147, 251, 0.4);
}

.card-icon {
  font-size: 64rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.card-arrow {
  position: absolute;
  bottom: 20rpx;
  right: 24rpx;
  font-size: 36rpx;
  color: #ccc;
  font-weight: bold;
}

/* 提示卡片 */
.tip-card {
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.tip-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tip-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fa8c16;
  margin-bottom: 8rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #d48806;
  line-height: 1.6;
}
