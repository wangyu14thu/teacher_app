/* pages/project-design/project-design.wxss */
.design-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #f5f7fa 0%, #ffffff 300rpx);
  padding: 30rpx 30rpx 200rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin: 40rpx 0 50rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 一键导入 */
.import-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.btn-import {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
  border: none;
}

.btn-import::after {
  border: none;
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.import-tip {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

/* 表单区块 */
.form-section {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 32rpx;
}

.title-dot {
  color: #667eea;
  margin-right: 12rpx;
  font-size: 24rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  background: #f5f7fa;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  background: #f5f7fa;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 180rpx;
  box-sizing: border-box;
}

/* 带生成按钮的输入框 */
.form-item-with-btn {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.form-textarea-ai {
  width: 100%;
  background: #f5f7fa;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 180rpx;
  box-sizing: border-box;
}

.btn-generate {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 12rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-generate::after {
  border: none;
}

.btn-generate-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.btn-generate-section {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
  border: none;
}

.btn-generate-section::after {
  border: none;
}

.form-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.6;
}

/* 项目探究 */
.inquiry-item {
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid #e0e0e0;
}

.inquiry-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.inquiry-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
}

.btn-delete {
  background: #ff4d4f;
  color: white;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border: none;
}

.btn-delete::after {
  border: none;
}

.btn-add-inquiry {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  color: #667eea;
  border: 2rpx dashed #667eea;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-add-inquiry::after {
  border: none;
}

.btn-add-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  gap: 20rpx;
  z-index: 100;
}

.btn-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  padding: 20rpx 10rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: none;
  min-height: 120rpx;
}

.btn-action::after {
  border: none;
}

.btn-action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.btn-action-sub {
  font-size: 20rpx;
  margin-top: 4rpx;
  opacity: 0.8;
}

.btn-save {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: white;
}

.btn-evaluate {
  background: linear-gradient(135deg, #fa8c16 0%, #ffa940 100%);
  color: white;
}

.btn-publish {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: white;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-container {
  width: 650rpx;
  max-height: 80vh;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-content {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.standard-item {
  margin-bottom: 24rpx;
}

.standard-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.standard-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.standard-highlight {
  background: #fff7e6;
  border-left: 4rpx solid #fa8c16;
  padding: 20rpx;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #fa8c16;
  line-height: 1.6;
}

.modal-footer {
  padding: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.agreement-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.agreement-label text {
  margin-left: 12rpx;
}

.btn-modal-confirm {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.btn-modal-confirm::after {
  border: none;
}

.btn-modal-confirm[disabled] {
  background: #d9d9d9;
  color: #999;
}

