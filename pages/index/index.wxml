<!--pages/index/index.wxml-->
<view class="index-container">
  <!-- 顶部轮播 -->
  <swiper class="top-swiper" indicator-dots="true" autoplay="true" interval="3000" duration="500" circular="true" bindtap="goToVIPWorkshop">
    <swiper-item>
      <view class="swiper-content">
        <text class="swiper-icon">👑</text>
        <text class="swiper-title">SVIP专属线下工作坊</text>
        <text class="swiper-desc">点击了解更多</text>
      </view>
    </swiper-item>
  </swiper>

  <!-- 三大模块 -->
  <view class="main-modules">
    <!-- 专题讲座 -->
    <view class="module-card lecture-card" bindtap="navigateToLecture">
      <view class="card-header">
        <text class="card-icon">🎤</text>
        <text class="card-title">专题讲座</text>
      </view>
      <text class="card-desc">专业导师精彩分享</text>
      <view class="card-arrow">→</view>
    </view>

    <!-- 项目案例 -->
    <view class="module-card cases-card" bindtap="navigateToCases">
      <view class="card-header">
        <text class="card-icon">📚</text>
        <text class="card-title">项目案例</text>
      </view>
      <text class="card-desc">各年级优质案例库</text>
      <view class="card-badge">{{totalCases}}+</view>
      <view class="card-arrow">→</view>
    </view>

    <!-- 我的项目 -->
    <view class="module-card myproject-card" bindtap="navigateToMyProjects">
      <view class="card-header">
        <text class="card-icon">✏️</text>
        <text class="card-title">我的项目</text>
      </view>
      <text class="card-desc">设计与实施记录</text>
      <view class="card-arrow">→</view>
    </view>
  </view>

  <!-- 提示卡片 -->
  <view class="tips-card">
    <text class="tips-icon">💡</text>
    <view class="tips-content">
      <text class="tips-title">温馨提示</text>
      <text class="tips-text">发布优质项目可获得积分奖励，1积分=1元，可用于兑换资源</text>
    </view>
  </view>
</view>
