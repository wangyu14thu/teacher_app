/* pages/index/index.wxss */
.index-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

/* 轮播 */
.top-swiper {
  height: 280rpx;
  margin-bottom: 30rpx;
}

.swiper-content {
  height: 100%;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.swiper-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.swiper-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 12rpx;
}

.swiper-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 三大模块 */
.main-modules {
  padding: 0 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.module-card {
  background-color: white;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
  transition: all 0.3s;
}

.module-card:active {
  transform: scale(0.98);
}

.lecture-card {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.cases-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.myproject-card {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.card-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.card-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background-color: rgba(255, 255, 255, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: white;
  font-weight: bold;
}

.card-arrow {
  position: absolute;
  bottom: 20rpx;
  right: 30rpx;
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 提示卡片 */
.tips-card {
  margin: 0 30rpx;
  padding: 24rpx 30rpx;
  background-color: #fff3cd;
  border-radius: 16rpx;
  display: flex;
  align-items: flex-start;
}

.tips-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tips-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #856404;
  margin-bottom: 8rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #856404;
  line-height: 1.6;
}
