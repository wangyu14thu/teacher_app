<!--pages/profile/profile.wxml-->
<view class="profile-container">
  <!-- 头部信息卡片 -->
  <view class="profile-header">
    <view class="header-bg"></view>
    <view class="user-card">
      <view class="user-avatar" bindtap="{{isEditing ? 'changeAvatar' : ''}}">
        <image 
          wx:if="{{teacherInfo.avatar}}" 
          class="avatar-image" 
          src="{{teacherInfo.avatar}}" 
          mode="aspectFill"
        />
        <text wx:else class="avatar-icon">👨‍🏫</text>
        <view wx:if="{{isEditing}}" class="avatar-mask">
          <text class="camera-icon">📷</text>
        </view>
      </view>
      <view class="user-info" wx:if="{{!isEditing}}">
        <text class="user-name">{{teacherInfo.nickname || '未登录'}}</text>
        <text class="user-detail">{{teacherInfo.subject}} · {{teacherInfo.grade}}</text>
        <text class="user-region" wx:if="{{teacherInfo.region}}">{{teacherInfo.region}}</text>
      </view>
      <view class="user-info-edit" wx:else>
        <view class="edit-item">
          <text class="edit-label">昵称</text>
          <input 
            class="edit-input" 
            value="{{editData.nickname}}" 
            bindinput="onEditInput" 
            data-field="nickname"
            placeholder="请输入昵称"
          />
        </view>
        <view class="edit-item">
          <text class="edit-label">学科</text>
          <input 
            class="edit-input" 
            value="{{editData.subject}}" 
            bindinput="onEditInput" 
            data-field="subject"
            placeholder="如：语文"
          />
        </view>
        <view class="edit-item">
          <text class="edit-label">年级</text>
          <input 
            class="edit-input" 
            value="{{editData.grade}}" 
            bindinput="onEditInput" 
            data-field="grade"
            placeholder="如：五年级"
          />
        </view>
        <view class="edit-item">
          <text class="edit-label">地区</text>
          <input 
            class="edit-input" 
            value="{{editData.region}}" 
            bindinput="onEditInput" 
            data-field="region"
            placeholder="如：北京市海淀区"
          />
        </view>
      </view>
      <view class="edit-actions">
        <button class="btn-edit" wx:if="{{!isEditing}}" bindtap="startEdit">
          <text class="edit-icon">✏️</text>
          <text>编辑</text>
        </button>
        <button class="btn-cancel" wx:else bindtap="cancelEdit">取消</button>
        <button class="btn-save" wx:if="{{isEditing}}" bindtap="saveProfile">保存</button>
      </view>
    </view>
  </view>

  <!-- 积分卡片 -->
  <view class="points-card">
    <view class="points-left">
      <text class="points-icon">💎</text>
      <view class="points-info">
        <text class="points-value">{{teacherInfo.points || 0}}</text>
        <text class="points-label">我的积分</text>
      </view>
    </view>
    <button class="btn-points-info" bindtap="showPointsInfo">
      <text>积分说明</text>
      <text class="arrow">›</text>
    </button>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" bindtap="goToMyProjects">
        <view class="menu-left">
          <text class="menu-icon">📁</text>
          <text class="menu-title">我的项目</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToPointsRecord">
        <view class="menu-left">
          <text class="menu-icon">💎</text>
          <text class="menu-title">我的积分</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="createSchoolTeam">
        <view class="menu-left">
          <text class="menu-icon">🏫</text>
          <text class="menu-title">创建学校团队</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToMySchool">
        <view class="menu-left">
          <text class="menu-icon">🎓</text>
          <text class="menu-title">我的学校</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToAdminDashboard">
        <view class="menu-left">
          <text class="menu-icon">⚙️</text>
          <text class="menu-title">管理后台</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="contactUs">
        <view class="menu-left">
          <text class="menu-icon">📞</text>
          <text class="menu-title">联系我们</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>

