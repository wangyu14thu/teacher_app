<!--pages/profile/profile.wxml-->
<view class="profile-container">
  <!-- 头部信息卡片 -->
  <view class="profile-header">
    <view class="header-bg"></view>
    <view class="user-card">
      <view class="user-avatar">
        <text class="avatar-icon">👨‍🏫</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{teacherInfo.nickname || '未登录'}}</text>
        <text class="user-detail">{{teacherInfo.subject}} · {{teacherInfo.grade}}</text>
        <text class="user-region" wx:if="{{teacherInfo.region}}">{{teacherInfo.region}}</text>
      </view>
      <button class="btn-edit" bindtap="editProfile">编辑</button>
    </view>
  </view>

  <!-- 积分卡片 -->
  <view class="points-card">
    <view class="points-left">
      <text class="points-icon">💎</text>
      <view class="points-info">
        <text class="points-value">{{teacherInfo.points || 0}}</text>
        <text class="points-label">我的积分</text>
      </view>
    </view>
    <button class="btn-points-info" bindtap="showPointsInfo">
      <text>积分说明</text>
      <text class="arrow">›</text>
    </button>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" bindtap="goToPointsRecord">
        <view class="menu-left">
          <text class="menu-icon">💎</text>
          <text class="menu-title">我的积分</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="createSchoolTeam">
        <view class="menu-left">
          <text class="menu-icon">🏫</text>
          <text class="menu-title">创建学校团队</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToMySchool">
        <view class="menu-left">
          <text class="menu-icon">🎓</text>
          <text class="menu-title">我的学校</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToAdminDashboard">
        <view class="menu-left">
          <text class="menu-icon">⚙️</text>
          <text class="menu-title">管理后台</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="contactUs">
        <view class="menu-left">
          <text class="menu-icon">📞</text>
          <text class="menu-title">联系我们</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>

