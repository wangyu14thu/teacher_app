/* pages/project-view/project-view.wxss */
.project-view-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #f5f7fa 0%, #ffffff 400rpx);
  padding: 30rpx 30rpx 200rpx;
}

/* 标题卡片 */
.title-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.project-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  color: white;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 区块卡片 */
.section-card {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 内容项 */
.content-item {
  margin-bottom: 24rpx;
}

.content-item:last-child {
  margin-bottom: 0;
}

.item-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.item-content {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 高亮内容 */
.highlight-content {
  background: linear-gradient(135deg, #f6f8fc 0%, #eef2f7 100%);
  border-left: 4rpx solid #667eea;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  gap: 12rpx;
  z-index: 100;
}

.btn-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  border: none;
  min-height: 100rpx;
}

.btn-action::after {
  border: none;
}

.btn-action-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.btn-secondary {
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  color: #666;
}

.btn-download {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: white;
}

.btn-evaluate {
  background: linear-gradient(135deg, #fa8c16 0%, #ffa940 100%);
  color: white;
}

.btn-publish {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: white;
}

/* 弹窗样式（与 project-design 一致） */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-container {
  width: 650rpx;
  max-height: 80vh;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-content {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.standard-item {
  margin-bottom: 24rpx;
}

.standard-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.standard-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.standard-highlight {
  background: #fff7e6;
  border-left: 4rpx solid #fa8c16;
  padding: 20rpx;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #fa8c16;
  line-height: 1.6;
}

.modal-footer {
  padding: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.agreement-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.agreement-label text {
  margin-left: 12rpx;
}

.btn-modal-confirm {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.btn-modal-confirm::after {
  border: none;
}

.btn-modal-confirm[disabled] {
  background: #d9d9d9;
  color: #999;
}

/* 导出弹窗样式 */
.export-modal {
  width: 600rpx;
}

.export-options {
  padding: 20rpx;
}

.export-option {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s;
}

.export-option:last-child {
  margin-bottom: 0;
}

.export-option:active {
  background: #e8ecf1;
  transform: scale(0.98);
}

.export-icon {
  font-size: 60rpx;
  margin-right: 24rpx;
}

.export-info {
  display: flex;
  flex-direction: column;
}

.export-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.export-desc {
  font-size: 24rpx;
  color: #999;
}

