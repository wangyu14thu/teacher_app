/* pages/reviewer/school-detail/index.wxss */
page {
  background: #f5f7fa;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.school-detail-container {
  min-height: 100vh;
  padding: 30rpx;
}

.info-card {
  background: white;
  padding: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.badge.type {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: #e6f7ff;
  color: #1890ff;
  font-size: 22rpx;
}

.info-row {
  display: flex;
  margin-bottom: 16rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.section-card {
  background: white;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
}

.decision-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.btn-decision {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 3rpx solid #d9d9d9;
  background: white;
}

.btn-decision.btn-pass.active {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: white;
  border-color: transparent;
}

.btn-decision.btn-reject.active {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: white;
  border-color: transparent;
}

.btn-decision::after {
  border: none;
}

.btn-icon {
  font-size: 48rpx;
  font-weight: bold;
}

.btn-text {
  font-size: 28rpx;
  font-weight: bold;
}

.opinion-section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.opinion-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.opinion-label.required::after {
  content: ' *';
  color: #ff4d4f;
}

.opinion-option {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}

.opinion-option:last-child {
  border-bottom: none;
}

.opinion-text {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: white;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.btn-submit:disabled {
  background: #d9d9d9;
  color: #999;
}

.btn-submit::after {
  border: none;
}

