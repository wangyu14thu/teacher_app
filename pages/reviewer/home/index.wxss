/* pages/reviewer/home/index.wxss */
page {
  background: #f5f7fa;
  height: 100%;
}

.reviewer-home-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 顶部导航栏 */
.top-bar {
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.top-left {
  display: flex;
  align-items: center;
}

.app-icon {
  font-size: 48rpx;
  margin-right: 12rpx;
}

.app-name {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.top-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.btn-logout {
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  border: none;
}

.btn-logout::after {
  border: none;
}

.logout-icon {
  font-size: 32rpx;
}

/* 关键数据卡片 */
.stats-cards {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
}

.stat-card {
  flex: 1;
  background: white;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.stat-card.urgent {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff4757 100%);
  color: white;
}

.stat-card.success {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: white;
}

.stat-number {
  display: block;
  font-size: 64rpx;
  font-weight: bold;
  line-height: 1;
  margin-bottom: 12rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

.stat-icon {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  font-size: 48rpx;
  opacity: 0.3;
}

/* 任务选项卡 */
.task-tabs {
  display: flex;
  background: white;
  margin: 0 30rpx 20rpx;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border-radius: 12rpx;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  box-shadow: 0 4rpx 12rpx rgba(30, 60, 114, 0.3);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
}

.tab-item.active .tab-text {
  color: white;
}

.tab-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: #ff4d4f;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

/* 筛选栏 */
.filter-bar {
  padding: 0 30rpx 20rpx;
}

.filter-section {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.filter-picker {
  flex: 1;
}

.picker-display {
  display: flex;
  align-items: center;
  background: white;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.filter-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

.picker-arrow {
  margin-left: auto;
  color: #999;
  font-size: 24rpx;
}

/* 批量操作栏 */
.batch-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff7e6;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid #ffd666;
}

.batch-text {
  flex: 1;
  font-size: 26rpx;
  color: #d48806;
  font-weight: 500;
}

.btn-batch-reject,
.btn-batch-cancel {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  border: none;
}

.btn-batch-reject {
  background: #ff4d4f;
  color: white;
}

.btn-batch-cancel {
  background: #d9d9d9;
  color: #666;
}

.btn-batch-reject::after,
.btn-batch-cancel::after {
  border: none;
}

/* 任务列表 */
.task-list {
  height: calc(100vh - 480rpx);
  padding: 0 30rpx;
}

.task-item {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
}

.task-item.urgent {
  border-left: 6rpx solid #ff4d4f;
}

.task-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.task-checkbox {
  margin-right: 16rpx;
}

.task-content {
  flex: 1;
}

.task-content.full-width {
  width: 100%;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.task-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-right: 16rpx;
}

.task-badges {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.badge.urgent {
  background: #ff4d4f;
  color: white;
}

.badge.type {
  background: #e6f7ff;
  color: #1890ff;
}

.task-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.task-time {
  font-size: 24rpx;
  color: #ccc;
}

.task-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部快捷入口 */
.bottom-shortcuts {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: white;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.shortcut-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
}

.shortcut-icon {
  font-size: 40rpx;
}

.shortcut-text {
  font-size: 22rpx;
  color: #666;
}

.shortcut-badge {
  position: absolute;
  top: 0;
  right: 25%;
  background: #ff4d4f;
  color: white;
  font-size: 18rpx;
  padding: 4rpx 8rpx;
  border-radius: 20rpx;
  min-width: 28rpx;
  text-align: center;
}

/* 批量驳回弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-container {
  width: 90%;
  max-width: 600rpx;
  max-height: 70vh;
  background: white;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-content {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.reject-option {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.reject-option:last-child {
  border-bottom: none;
}

.reject-text {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #f0f0f0;
}

.btn-modal-cancel,
.btn-modal-confirm {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.btn-modal-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-modal-confirm {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: white;
}

.btn-modal-confirm:disabled {
  background: #d9d9d9;
  color: #999;
}

.btn-modal-cancel::after,
.btn-modal-confirm::after {
  border: none;
}
