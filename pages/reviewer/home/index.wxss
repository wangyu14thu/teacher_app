/* pages/reviewer/home/index.wxss */
page {
  background: #f5f7fa;
}

.reviewer-home-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部导航栏 */
.top-bar {
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.top-left {
  display: flex;
  align-items: center;
}

.app-icon {
  font-size: 48rpx;
  margin-right: 12rpx;
}

.app-name {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.top-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.btn-logout {
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  border: none;
  font-size: 24rpx;
}

.btn-logout::after {
  border: none;
}

.logout-icon {
  font-size: 32rpx;
}

/* 欢迎区域 */
.welcome-section {
  background: white;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  position: relative;
}

.welcome-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #1e3c72;
  margin-bottom: 12rpx;
}

.welcome-subtitle {
  display: block;
  font-size: 26rpx;
  color: #7e8ba3;
  margin-bottom: 20rpx;
}

.welcome-badge {
  display: inline-block;
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.badge-text {
  font-size: 22rpx;
  color: white;
  letter-spacing: 2rpx;
}

/* 统计卡片网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-number {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #1e3c72;
  line-height: 1;
  margin-bottom: 12rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 功能区域 */
.function-section {
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.function-card {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
  transition: all 0.3s;
}

.function-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.function-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.function-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.badge-pending {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #ff4d4f;
  color: white;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  min-width: 40rpx;
  text-align: center;
}

/* 开发中提示 */
.dev-notice {
  margin: 40rpx 30rpx 0;
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
  border: 2rpx solid #ffd666;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
}

.dev-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.dev-text {
  display: block;
  font-size: 28rpx;
  color: #d48806;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.dev-desc {
  display: block;
  font-size: 24rpx;
  color: #d48806;
  opacity: 0.8;
}

