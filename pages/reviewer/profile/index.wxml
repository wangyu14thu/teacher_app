<!--pages/reviewer/profile/index.wxml-->
<view class="profile-container">
  <!-- 个人信息卡片 -->
  <view class="info-card">
    <view class="avatar-section">
      <text class="avatar-icon">👤</text>
      <view class="user-info">
        <text class="user-name">{{reviewerInfo.name}}</text>
        <text class="user-dept">{{reviewerInfo.department}}</text>
      </view>
    </view>
  </view>

  <!-- 审核统计 -->
  <view class="stats-section">
    <view class="stats-title">审核统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-number">{{stats.totalReviews}}</text>
        <text class="stat-label">累计审核</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.todayReviews}}</text>
        <text class="stat-label">今日审核</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.passRate}}%</text>
        <text class="stat-label">通过率</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.avgTime}}分钟</text>
        <text class="stat-label">平均用时</text>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="navigateToHistory">
      <text class="menu-icon">📋</text>
      <text class="menu-text">审核历史</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="navigateToTempTasks">
      <text class="menu-icon">💾</text>
      <text class="menu-text">暂存任务</text>
      <view class="menu-badge" wx:if="{{tempCount > 0}}">{{tempCount}}</view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="btn-logout" bindtap="handleLogout">退出登录</button>
  </view>
</view>

