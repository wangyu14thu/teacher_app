/* pages/reviewer/project-detail/index.wxss */
page {
  background: #f5f7fa;
  padding-bottom: calc(320rpx + env(safe-area-inset-bottom));
}

.project-detail-container {
  min-height: 100vh;
}

/* 审核要点提示 */
.tips-card {
  background: linear-gradient(135deg, #fff7e6 0%, #fffbf0 100%);
  margin: 20rpx 30rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid #faad14;
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tips-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.tips-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
  color: #d48806;
}

.tips-close {
  font-size: 40rpx;
  color: #d48806;
  line-height: 1;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #8c6d1f;
  line-height: 1.6;
}

/* 基本信息卡片 */
.info-card {
  background: white;
  margin: 20rpx 30rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-right: 16rpx;
}

.project-badges {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  text-align: center;
}

.badge.urgent {
  background: #ff4d4f;
  color: white;
}

.badge.type {
  background: #e6f7ff;
  color: #1890ff;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.teacher-info {
  padding-top: 20rpx;
  border-top: 2rpx dashed #e8e8e8;
}

.teacher-label {
  font-size: 26rpx;
  color: #666;
}

.teacher-name {
  font-size: 26rpx;
  color: #1890ff;
  font-weight: 500;
}

/* 内容滚动区 */
.content-scroll {
  height: calc(100vh - 480rpx);
  padding: 0 30rpx;
}

/* 内容卡片 */
.section-card {
  background: white;
  margin-bottom: 20rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-card.highlight {
  background: linear-gradient(135deg, #f0f5ff 0%, #f9fcff 100%);
  border-left: 6rpx solid #1890ff;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.subsection {
  margin-bottom: 24rpx;
}

.subsection:last-child {
  margin-bottom: 0;
}

.subsection-title {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.subsection-content {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.highlight-text {
  color: #1890ff;
  font-weight: 500;
  background: #f0f5ff;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
}

.sub-questions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sub-question-item {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  padding-left: 8rpx;
}

/* 底部操作区 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  max-height: 60vh;
  overflow-y: auto;
}

/* 审核决定按钮 */
.decision-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.btn-decision {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 3rpx solid #d9d9d9;
  background: white;
  transition: all 0.3s;
}

.btn-decision.btn-pass {
  border-color: #52c41a;
  color: #52c41a;
}

.btn-decision.btn-pass.active {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: white;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(82, 196, 26, 0.3);
}

.btn-decision.btn-reject {
  border-color: #ff4d4f;
  color: #ff4d4f;
}

.btn-decision.btn-reject.active {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: white;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
}

.btn-decision::after {
  border: none;
}

.btn-icon {
  font-size: 48rpx;
  font-weight: bold;
}

.btn-text {
  font-size: 28rpx;
  font-weight: bold;
}

/* 审核意见区域 */
.opinion-section {
  max-height: 600rpx;
  overflow-y: auto;
  margin-bottom: 24rpx;
}

.opinion-group {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.opinion-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.opinion-label.required::after {
  content: ' *';
  color: #ff4d4f;
}

.opinion-option {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}

.opinion-option:last-child {
  border-bottom: none;
}

.opinion-text {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 自定义输入 */
.custom-input {
  padding: 24rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.custom-textarea {
  width: 100%;
  min-height: 150rpx;
  background: white;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 底部操作按钮 */
.bottom-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1.5fr;
  gap: 16rpx;
}

.btn-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  border: none;
}

.btn-action::after {
  border: none;
}

.btn-action.btn-secondary {
  background: #f5f5f5;
  color: #666;
}

.btn-action.btn-primary {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: white;
  grid-column: span 1;
}

.btn-action.btn-primary:disabled {
  background: #d9d9d9;
  color: #999;
}

.action-icon {
  font-size: 32rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-container {
  width: 90%;
  max-width: 600rpx;
  max-height: 70vh;
  background: white;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
  position: relative;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  padding-right: 60rpx;
}

.modal-subtitle {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.modal-close {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-content {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.note-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #fafafa;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  margin: 24rpx 32rpx 8rpx;
}

.transfer-tip {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.reviewer-option {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.reviewer-option:last-child {
  border-bottom: none;
}

.reviewer-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.reviewer-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.reviewer-meta {
  font-size: 24rpx;
  color: #999;
}

.transfer-reason {
  width: 100%;
  min-height: 120rpx;
  background: #fafafa;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 20rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #f0f0f0;
}

.btn-modal-cancel,
.btn-modal-confirm {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.btn-modal-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-modal-confirm {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: white;
}

.btn-modal-confirm:disabled {
  background: #d9d9d9;
  color: #999;
}

.btn-modal-cancel::after,
.btn-modal-confirm::after {
  border: none;
}

