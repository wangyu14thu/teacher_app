<!--pages/reviewer/project-detail/index.wxml-->
<view class="project-detail-container">
  <!-- 审核要点提示（首次/复杂任务） -->
  <view class="tips-card" wx:if="{{showTips}}">
    <view class="tips-header">
      <text class="tips-icon">💡</text>
      <text class="tips-title">审核要点提示</text>
      <text class="tips-close" bindtap="closeTips">×</text>
    </view>
    <view class="tips-content">
      <text class="tip-item">✓ 驱动性问题是否符合PBL格式，具有真实探究性</text>
      <text class="tip-item">✓ 学科融合是否自然，课标关联是否清晰</text>
      <text class="tip-item">✓ 项目目标与活动、成果是否关联紧密</text>
      <text class="tip-item">✓ 最终成果是否具体可展示</text>
    </view>
  </view>

  <!-- 项目基本信息卡片 -->
  <view class="info-card">
    <view class="card-header">
      <text class="card-title">{{projectData.projectName}}</text>
      <view class="project-badges">
        <text class="badge urgent" wx:if="{{projectData.urgent}}">紧急</text>
        <text class="badge type">{{projectData.type === 'publish' ? '发布申请' : '评估申请'}}</text>
      </view>
    </view>
    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">年级</text>
        <text class="info-value">{{projectData.grade}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">学科</text>
        <text class="info-value">{{projectData.subject}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">课时</text>
        <text class="info-value">{{projectData.hours}}课时</text>
      </view>
      <view class="info-item">
        <text class="info-label">提交时间</text>
        <text class="info-value">{{projectData.submitTime}}</text>
      </view>
    </view>
    <view class="teacher-info">
      <text class="teacher-label">提交教师：</text>
      <text class="teacher-name">{{projectData.teacherName}}</text>
    </view>
  </view>

  <!-- 项目内容展示 -->
  <scroll-view class="content-scroll" scroll-y>
    <!-- 项目概述 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-icon">📝</text>
        <text class="section-title">项目概述</text>
      </view>
      <text class="section-content">{{projectData.overview}}</text>
    </view>

    <!-- 立项依据 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-icon">📚</text>
        <text class="section-title">项目立项依据</text>
      </view>
      <view class="subsection">
        <text class="subsection-title">依据现实世界</text>
        <text class="subsection-content">{{projectData.realWorld}}</text>
      </view>
      <view class="subsection">
        <text class="subsection-title">依据课标教材</text>
        <text class="subsection-content">{{projectData.curriculum}}</text>
      </view>
      <view class="subsection">
        <text class="subsection-title">依据学生实际</text>
        <text class="subsection-content">{{projectData.studentLevel}}</text>
      </view>
    </view>

    <!-- 跨学科概念 -->
    <view class="section-card highlight">
      <view class="section-header">
        <text class="section-icon">🔗</text>
        <text class="section-title">跨学科概念</text>
      </view>
      <text class="section-content">{{projectData.crossConcept}}</text>
    </view>

    <!-- 项目框架 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-icon">🎯</text>
        <text class="section-title">项目框架</text>
      </view>
      <view class="subsection">
        <text class="subsection-title">驱动性问题</text>
        <text class="subsection-content highlight-text">{{projectData.drivingQuestion}}</text>
      </view>
      <view class="subsection">
        <text class="subsection-title">子问题链</text>
        <view class="sub-questions">
          <text class="sub-question-item" wx:for="{{projectData.subQuestions}}" wx:key="index">
            {{index + 1}}. {{item}}
          </text>
        </view>
      </view>
      <view class="subsection">
        <text class="subsection-title">最终成果</text>
        <text class="subsection-content">{{projectData.finalProduct}}</text>
      </view>
      <view class="subsection">
        <text class="subsection-title">成果展示形式</text>
        <text class="subsection-content">{{projectData.presentForm}}</text>
      </view>
    </view>

    <!-- 项目目标 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-icon">🎓</text>
        <text class="section-title">项目目标</text>
      </view>
      <text class="section-content">{{projectData.objectives}}</text>
    </view>
  </scroll-view>

  <!-- 固定底部操作区 -->
  <view class="action-bar">
    <!-- 审核决定按钮 -->
    <view class="decision-buttons">
      <button 
        class="btn-decision btn-pass {{reviewDecision === 'pass' ? 'active' : ''}}"
        bindtap="selectDecision"
        data-decision="pass"
      >
        <text class="btn-icon">✓</text>
        <text class="btn-text">通过</text>
      </button>
      <button 
        class="btn-decision btn-reject {{reviewDecision === 'reject' ? 'active' : ''}}"
        bindtap="selectDecision"
        data-decision="reject"
      >
        <text class="btn-icon">✗</text>
        <text class="btn-text">驳回</text>
      </button>
    </view>

    <!-- 审核意见选择 -->
    <view class="opinion-section" wx:if="{{reviewDecision}}">
      <!-- 驳回必选（B类） -->
      <view class="opinion-group" wx:if="{{reviewDecision === 'reject'}}">
        <text class="opinion-label required">驳回原因（必选）</text>
        <radio-group bindchange="onRejectReasonChange">
          <label class="opinion-option" wx:for="{{rejectReasons}}" wx:key="id">
            <radio value="{{item.id}}" checked="{{selectedRejectReason === item.id}}"/>
            <text class="opinion-text">{{item.text}}</text>
          </label>
        </radio-group>
      </view>

      <!-- 通过评语（A类，可选） -->
      <view class="opinion-group" wx:if="{{reviewDecision === 'pass'}}">
        <text class="opinion-label">评语（可选）</text>
        <radio-group bindchange="onPassCommentChange">
          <label class="opinion-option" wx:for="{{passComments}}" wx:key="id">
            <radio value="{{item.id}}" checked="{{selectedPassComment === item.id}}"/>
            <text class="opinion-text">{{item.text}}</text>
          </label>
        </radio-group>
      </view>

      <!-- 优化建议（C类，可多选） -->
      <view class="opinion-group">
        <text class="opinion-label">优化建议（可选，可多选）</text>
        <checkbox-group bindchange="onSuggestionsChange">
          <label class="opinion-option" wx:for="{{suggestions}}" wx:key="id">
            <checkbox value="{{item.id}}" checked="{{selectedSuggestions.indexOf(item.id) > -1}}"/>
            <text class="opinion-text">{{item.text}}</text>
          </label>
        </checkbox-group>
      </view>

      <!-- 自定义补充 -->
      <view class="custom-input">
        <text class="input-label">自定义补充说明（可选）</text>
        <textarea 
          class="custom-textarea"
          placeholder="您可以在此添加更详细的说明..."
          value="{{customComment}}"
          bindinput="onCustomCommentInput"
          maxlength="500"
        />
        <text class="char-count">{{customComment.length}}/500</text>
      </view>
    </view>

    <!-- 底部操作按钮组 -->
    <view class="bottom-actions">
      <button class="btn-action btn-secondary" bindtap="saveToTemp">
        <text class="action-icon">💾</text>
        <text>暂存</text>
      </button>
      <button class="btn-action btn-secondary" bindtap="showInternalNote">
        <text class="action-icon">📝</text>
        <text>内部备注</text>
      </button>
      <button class="btn-action btn-secondary" bindtap="showTransferModal">
        <text class="action-icon">↗️</text>
        <text>转交</text>
      </button>
      <button 
        class="btn-action btn-primary" 
        bindtap="submitReview"
        disabled="{{!canSubmit}}"
      >
        <text class="action-icon">📤</text>
        <text>提交审核</text>
      </button>
    </view>
  </view>

  <!-- 内部备注弹窗 -->
  <view class="modal-mask" wx:if="{{showNoteModal}}" bindtap="closeNoteModal">
    <view class="modal-container" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">内部备注</text>
        <text class="modal-subtitle">（仅审核员可见）</text>
        <text class="modal-close" bindtap="closeNoteModal">×</text>
      </view>
      <textarea 
        class="note-textarea"
        placeholder="记录存疑点或需要注意的地方..."
        value="{{internalNote}}"
        bindinput="onInternalNoteInput"
        maxlength="300"
      />
      <text class="char-count">{{internalNote.length}}/300</text>
      <view class="modal-footer">
        <button class="btn-modal-cancel" bindtap="closeNoteModal">取消</button>
        <button class="btn-modal-confirm" bindtap="saveInternalNote">保存备注</button>
      </view>
    </view>
  </view>

  <!-- 转交任务弹窗 -->
  <view class="modal-mask" wx:if="{{showTransferModal}}" bindtap="closeTransferModal">
    <view class="modal-container" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">转交任务</text>
        <text class="modal-close" bindtap="closeTransferModal">×</text>
      </view>
      <scroll-view class="modal-content" scroll-y>
        <text class="transfer-tip">请选择要转交给的审核员：</text>
        <radio-group bindchange="onTransferTargetChange">
          <label class="reviewer-option" wx:for="{{availableReviewers}}" wx:key="id">
            <radio value="{{item.id}}" checked="{{transferTarget === item.id}}"/>
            <view class="reviewer-info">
              <text class="reviewer-name">{{item.name}}</text>
              <text class="reviewer-meta">{{item.department}} · 擅长{{item.gradeLevel}}</text>
            </view>
          </label>
        </radio-group>
        <textarea 
          class="transfer-reason"
          placeholder="转交原因（可选）"
          value="{{transferReason}}"
          bindinput="onTransferReasonInput"
          maxlength="200"
        />
      </scroll-view>
      <view class="modal-footer">
        <button class="btn-modal-cancel" bindtap="closeTransferModal">取消</button>
        <button 
          class="btn-modal-confirm" 
          bindtap="confirmTransfer"
          disabled="{{!transferTarget}}"
        >
          确认转交
        </button>
      </view>
    </view>
  </view>
</view>

