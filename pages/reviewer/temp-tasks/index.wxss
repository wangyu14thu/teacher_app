/* pages/reviewer/temp-tasks/index.wxss */
page {
  background: #f5f7fa;
}

.temp-tasks-container {
  min-height: 100vh;
  padding: 30rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-item {
  background: white;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.task-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.task-badge {
  padding: 4rpx 12rpx;
  background: #e6f7ff;
  color: #1890ff;
  font-size: 22rpx;
  border-radius: 6rpx;
}

.task-time {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.btn-delete {
  padding: 12rpx 24rpx;
  background: #ff4d4f;
  color: white;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
}

.btn-delete::after {
  border: none;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

