/* pages/lecture/lecture.wxss */
.lecture-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx;
}

.page-header {
  margin-bottom: 30rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #999;
  display: block;
}

.lecture-card {
  background-color: white;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
  position: relative;
  transition: all 0.3s;
}

.lecture-card:active {
  transform: scale(0.98);
}

.vip-card {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
}

.preview-card {
  background-color: white;
}

.card-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background-color: rgba(255, 255, 255, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: white;
}

.card-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
  text-align: center;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.vip-card .card-title {
  color: white;
}

.preview-card .card-title {
  color: #333;
}

.card-desc {
  font-size: 26rpx;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.vip-card .card-desc {
  color: rgba(255, 255, 255, 0.9);
}

.preview-card .card-desc {
  color: #666;
}

.preview-list {
  margin: 24rpx 0;
  padding: 24rpx;
  background-color: #f5f7fa;
  border-radius: 12rpx;
}

.preview-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.preview-item:last-child {
  margin-bottom: 0;
}

.preview-dot {
  font-size: 28rpx;
  color: #4A90E2;
  margin-right: 12rpx;
  line-height: 1.6;
}

.preview-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  flex: 1;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.preview-card .card-footer {
  border-top-color: #e0e0e0;
}

.footer-text {
  font-size: 24rpx;
}

.vip-card .footer-text {
  color: rgba(255, 255, 255, 0.9);
}

.preview-card .footer-text {
  color: #999;
}

.footer-arrow {
  font-size: 40rpx;
}

.vip-card .footer-arrow {
  color: rgba(255, 255, 255, 0.7);
}

.preview-card .footer-arrow {
  color: #ccc;
}

.tips-card {
  padding: 24rpx 30rpx;
  background-color: #e3f2fd;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}

.tips-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #1976d2;
  line-height: 1.6;
  flex: 1;
}
