/* pages/lecture/lecture.wxss */
.lecture-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx;
}

.page-header {
  margin-bottom: 30rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #999;
  display: block;
}

.lecture-card {
  background-color: white;
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
  position: relative;
  transition: all 0.3s;
  text-align: center;
}

.lecture-card:active {
  transform: scale(0.98);
}

.theme-card {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.preview-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.card-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  color: white;
}

.tips-card {
  padding: 24rpx 30rpx;
  background-color: #e3f2fd;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}

.tips-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #1976d2;
  line-height: 1.6;
  flex: 1;
}
