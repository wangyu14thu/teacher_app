<!--pages/lecture/lecture.wxml-->
<view class="lecture-container">
  <view class="page-header">
    <text class="header-title">专题讲座</text>
    <text class="header-subtitle">专业导师精彩分享</text>
  </view>

  <!-- 讲座主题 -->
  <view class="lecture-card theme-card" bindtap="showThemeTip">
    <text class="card-icon">🎤</text>
    <text class="card-title">讲座主题</text>
  </view>

  <!-- 下期预告 -->
  <view class="lecture-card preview-card" bindtap="showPreviewTip">
    <text class="card-icon">📢</text>
    <text class="card-title">下期预告</text>
  </view>

  <!-- 提示卡片 -->
  <view class="tips-card">
    <text class="tips-icon">💡</text>
    <text class="tips-text">更多精彩讲座内容正在筹备中，敬请期待！</text>
  </view>
</view>
