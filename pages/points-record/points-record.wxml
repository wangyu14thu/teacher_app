<!--pages/points-record/points-record.wxml-->
<view class="points-container">
  <!-- 积分卡片 -->
  <view class="points-card">
    <view class="points-icon">💎</view>
    <view class="points-number">{{totalPoints}}</view>
    <text class="points-label">我的积分</text>
  </view>

  <!-- 积分说明 -->
  <view class="info-card">
    <view class="info-icon">ℹ️</view>
    <view class="info-content">
      <text class="info-title">积分说明</text>
      <text class="info-text">积分通过个人创作（如发布优质项目）和行为获得，归属个人，可用于兑换平台会员、服务或礼品。</text>
    </view>
  </view>

  <!-- 积分记录 -->
  <view class="records-section">
    <view class="section-header">
      <text class="section-title">积分记录</text>
      <text class="section-count">共{{records.length}}条</text>
    </view>

    <view class="records-list">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="record-left">
          <text class="record-icon">{{item.icon}}</text>
          <view class="record-info">
            <text class="record-title">{{item.title}}</text>
            <text class="record-time">{{item.time}}</text>
          </view>
        </view>
        <view class="record-right">
          <text class="record-points {{item.type}}">{{item.type === 'add' ? '+' : '-'}}{{item.points}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{records.length === 0}}">
      <text class="empty-icon">📝</text>
      <text class="empty-text">暂无积分记录</text>
      <text class="empty-desc">发布优质项目获取积分吧</text>
    </view>
  </view>
</view>

